# Домен сайта. Caddy сам получит HTTPS-сертификат (A-запись домена должна указывать на сервер).
# Для проверки без домена: SITE_ADDRESS=:80 и COOKIE_SECURE=0
SITE_ADDRESS=example.ru

# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Пароли админки (минимум 12 символов, разные)
ADMIN_PASSWORD=
VIEWER_PASSWORD=

# 1 — сайт работает по HTTPS (на сервере всегда 1)
COOKIE_SECURE=1
